---
import type { Domain } from '@data/domains';
import { path } from '@utils/url';

interface Props {
  domain: Domain;
  currentTopic?: string;
}
const { domain, currentTopic } = Astro.props;
---
<aside class="sidebar" aria-label="Domain navigation">
  <button
    id="sidebar-toggle"
    type="button"
    class="sidebar-toggle"
    aria-label="Collapse sidebar"
    aria-controls="sidebar-inner"
  >
    <svg class="icon icon-collapse" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m15 18-6-6 6-6"/>
    </svg>
    <svg class="icon icon-expand" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 18 6-6-6-6"/>
    </svg>
  </button>

  <div id="sidebar-inner" class="sidebar-inner">
    <a href={path(`/${domain.slug}/`)} class="sidebar-home">
      <span class="sidebar-eyebrow">Domain</span>
      <span class="sidebar-title">{domain.title}</span>
    </a>
    <nav class="topic-list" aria-label="Topics">
      <ol>
        {domain.topics.map((topic, i) => (
          <li>
            <a
              href={path(`/${domain.slug}/${topic.slug}/`)}
              class={currentTopic === topic.slug ? 'active' : ''}
            >
              <span class="topic-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="topic-title">{topic.title}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
    <a href={path('/')} class="sidebar-back">← All domains</a>
  </div>
</aside>

<script is:inline>
  (function () {
    var btn = document.getElementById('sidebar-toggle');
    if (!btn) return;
    function syncLabel() {
      var collapsed = document.documentElement.classList.contains('sidebar-collapsed');
      btn.setAttribute('aria-label', collapsed ? 'Expand sidebar' : 'Collapse sidebar');
      btn.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    }
    syncLabel();
    btn.addEventListener('click', function () {
      var collapsed = document.documentElement.classList.toggle('sidebar-collapsed');
      try { localStorage.setItem('sidebar-collapsed', String(collapsed)); } catch (_) {}
      syncLabel();
    });
  })();
</script>

<style>
  .sidebar {
    position: relative;
    width: var(--sidebar-width);
    flex-shrink: 0;
    background: hsl(var(--surface-low));
    transition: width var(--t-base), background var(--t-base);
  }
  .sidebar-inner {
    position: sticky;
    top: 64px;
    padding: var(--sp-8) var(--sp-5) var(--sp-8) var(--sp-6);
    max-height: calc(100vh - 64px);
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    transition: opacity var(--t-fast);
  }

  /* ── collapse toggle ─────────────────────── */
  .sidebar-toggle {
    position: absolute;
    top: var(--sp-4);
    right: calc(-1 * var(--sp-10));
    z-index: 10;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    border: 0;
    border-radius: var(--radius);
    color: hsl(var(--muted-foreground));
    cursor: pointer;
    transition: background var(--t-fast), color var(--t-fast);
  }
  .sidebar-toggle:hover {
    background: hsl(var(--muted));
    color: hsl(var(--foreground));
  }
  .sidebar-toggle .icon-expand { display: none; }
  :global(html.sidebar-collapsed) .sidebar-toggle .icon-collapse { display: none; }
  :global(html.sidebar-collapsed) .sidebar-toggle .icon-expand { display: inline-block; }

  /* ── collapsed state ─────────────────────── */
  :global(html.sidebar-collapsed) .sidebar {
    width: 0;
    background: transparent;
  }
  :global(html.sidebar-collapsed) .sidebar-inner {
    opacity: 0;
    pointer-events: none;
  }

  .sidebar-home {
    display: block;
    text-decoration: none;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid hsl(var(--border) / 0.5);
  }
  .sidebar-home:hover { text-decoration: none; }
  .sidebar-eyebrow {
    display: block;
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground) / 0.75);
    font-weight: 600;
    margin-bottom: var(--sp-1);
  }
  .sidebar-title {
    display: block;
    font-family: var(--font-headline);
    font-weight: 700;
    font-size: var(--fs-lg);
    color: hsl(var(--foreground));
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .topic-list ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .topic-list li { margin: 0; }
  .topic-list a {
    display: flex;
    gap: var(--sp-3);
    align-items: baseline;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius);
    color: hsl(var(--muted-foreground));
    text-decoration: none;
    font-family: var(--font-sans);
    font-size: var(--fs-sm);
    line-height: 1.4;
    border-left: 2px solid transparent;
    transition: background var(--t-fast), color var(--t-fast), border-color var(--t-fast);
  }
  .topic-list a:hover {
    color: hsl(var(--foreground));
    background: hsl(var(--muted));
    text-decoration: none;
  }
  .topic-list a.active {
    color: hsl(var(--foreground));
    border-left-color: hsl(var(--primary));
    background: hsl(var(--muted));
    font-weight: 500;
  }
  .topic-num {
    color: hsl(var(--muted-foreground) / 0.65);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    min-width: 1.5em;
    font-variant-numeric: tabular-nums;
  }
  .topic-list a.active .topic-num { color: hsl(var(--primary)); }
  .topic-title { flex: 1; }

  .sidebar-back {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: hsl(var(--muted-foreground) / 0.75);
    text-decoration: none;
    padding: var(--sp-2) 0;
    border-top: 1px solid hsl(var(--border) / 0.5);
    margin-top: auto;
    font-weight: 600;
  }
  .sidebar-back:hover { color: hsl(var(--primary)); }

  @media (max-width: 900px) {
    .sidebar {
      width: 100%;
      border-bottom: 1px solid hsl(var(--border));
    }
    .sidebar-inner {
      position: static;
      max-height: none;
      padding: var(--sp-5) 0;
    }
    .sidebar-toggle { display: none; }
    :global(html.sidebar-collapsed) .sidebar {
      width: 100%;
    }
    :global(html.sidebar-collapsed) .sidebar-inner {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
