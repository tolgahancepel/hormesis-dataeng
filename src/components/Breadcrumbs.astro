---
interface Crumb { label: string; href?: string }
interface Props { items: Crumb[] }
const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>
        {c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}
        {i < items.length - 1 && <span class="sep" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin: 0 0 var(--sp-4);
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: hsl(var(--muted-foreground) / 0.75);
    font-weight: 600;
  }
  .breadcrumbs li {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
  }
  .breadcrumbs a {
    color: hsl(var(--muted-foreground) / 0.75);
    text-decoration: none;
    transition: color var(--t-fast);
  }
  .breadcrumbs a:hover { color: hsl(var(--primary)); text-decoration: none; }
  .breadcrumbs span[aria-current='page'] { color: hsl(var(--foreground)); }
  .breadcrumbs .sep { opacity: 0.5; }
</style>
